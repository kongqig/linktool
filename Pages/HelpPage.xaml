<UserControl x:Class="linktool.Pages.HelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="帮助" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="LinkTool 用于将大文件夹迁移到其他盘符，并在原路径创建目录链接，使依赖原路径的程序无需改动即可继续访问。" Style="{StaticResource Hint}" Margin="0,6,0,18"/>

                    <TextBlock Text="迁移" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                               Text="选择源文件夹（From）与目标文件夹（To），点击“迁移”。程序将：1) 复制文件到目标；2) 删除源；3) 在原路径创建目录链接。迁移后通过原路径仍可访问。" />

                    <TextBlock Text="批量迁移" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                               Text="可一次迁移多个文件夹。支持“通用目标目录”批量指定目标；每行可单独指定目标路径（多对一 / 多对多）。支持直接粘贴多行路径与拖拽文件夹。" />

                    <TextBlock Text="链接 / 批量链接" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                               Text="仅创建目录链接，不复制不删除。链接位置（LINK）即旧路径，目标路径（Target）即真实目录。批量链接支持多行与通用目标目录。" />

                    <TextBlock Text="管理员权限" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="部分复制、删除、链接操作需要管理员权限。未提权时，主页底部会显示警告条，可点击“提权运行”重启。建议始终以管理员身份运行。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>