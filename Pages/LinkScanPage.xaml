<UserControl x:Class="linktool.Pages.LinkScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="链接扫描" Style="{StaticResource SectionTitle}"/>
                    <TextBox Text="递归扫描目录下的 Junction/符号链接（本体/目标/层数）。默认只记录不进入；勾选“启用链接递归”后跟随链接深入。"
                             Style="{StaticResource SelectableHint}" Margin="0,4,0,14"/>

                    <!-- 扫描路径：历史下拉 + 选择 + 扫描 -->
                    <TextBlock Text="扫描路径" Style="{StaticResource Label}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PathBox" Grid.Column="0" Style="{StaticResource PathComboBox}" IsEditable="True"
                                  ToolTip="要扫描的根目录；回车记忆到历史下拉" KeyDown="Path_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="选择" Style="{StaticResource SecondaryButton}" MinWidth="80"
                                    ToolTip="选择要扫描的目录（编辑框为空时打开上次选择的目录）" Click="BrowseButton_Click"/>
                            <Button x:Name="ScanButton" Content="扫描" Style="{StaticResource PrimaryButton}" MinWidth="100" Margin="8,0,0,0"
                                    ToolTip="后台递归扫描，扫描期间按钮不可用" Click="ScanButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 选项（两行紧凑） -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox x:Name="FollowLinksCheck" Content="启用链接递归" VerticalAlignment="Center"
                                  ToolTip="不勾选：遇到链接只记录，不进入；勾选：跟随链接继续扫描，受“递归限制”约束"/>
                        <TextBlock Text="递归限制" Style="{StaticResource Label}" Margin="20,0,8,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="LimitBox" Style="{StaticResource TextBoxStyle}" Width="70" Text="10"
                                 ToolTip="跟随链接的最大层数（路径上的链接数）：0=禁用；负数或超过 100 报错；超过 10 层警告循环链接"/>
                        <CheckBox x:Name="ShowHiddenCheck" Content="显示隐藏/系统目录" Margin="20,0,0,0" VerticalAlignment="Center"
                                  ToolTip="默认不勾选：跳过隐藏/系统目录（如「开始」菜单、Application Data 等系统兼容链接）；勾选后一并扫描"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="遍历深度" Style="{StaticResource Label}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="DirLimitBox" Style="{StaticResource TextBoxStyle}" Width="70" Text="0"
                                 ToolTip="目录遍历层级上限（0=不限制）：超过该层级的子目录不展开；负数或超过 100 报错"/>
                        <TextBox Style="{StaticResource SelectableHint}" Margin="10,0,0,0" VerticalAlignment="Center"
                                 Text="递归限制=跟随链接的最大层数（0=禁用；≤100；超 10 层警告循环）；遍历深度=目录层级上限（0=不限制；≤100），链接跳转后归零，两者互不影响"/>
                    </StackPanel>

                    <!-- 结果列表（路径单元格为只读 TextBox：文本可选中/复制，长路径悬停可看全） -->
                    <DataGrid x:Name="Grid" MinHeight="240" MaxHeight="420" IsReadOnly="False" Margin="0,12,0,0"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              RowBackground="White" AlternatingRowBackground="{StaticResource HoverBrush}"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="链接位置（本体）" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding LinkPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                 BorderThickness="0" Background="Transparent" IsTabStop="False"
                                                 VerticalContentAlignment="Center" ToolTip="{Binding LinkPath}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="目标位置" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Target, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                 BorderThickness="0" Background="Transparent" IsTabStop="False"
                                                 VerticalContentAlignment="Center" ToolTip="{Binding Target}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="层数" Binding="{Binding Depth}" Width="60" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding Depth}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 底部操作与状态 -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="CopyButton" Content="复制结果" Style="{StaticResource SecondaryButton}" MinWidth="110"
                                Click="CopyButton_Click" ToolTip="复制全部扫描结果（链接位置 / 目标位置 / 层数）"/>
                        <Button x:Name="ClearButton" Content="清空" Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="10,0,0,0"
                                Click="ClearButton_Click" ToolTip="清空扫描结果"/>
                    </StackPanel>
                    <TextBox x:Name="StatusText" Style="{StaticResource SelectableHint}" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
