<UserControl x:Class="linktool.Pages.BatchRetreatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:linktool.Pages">
    <UserControl.Resources>
        <local:StatusBrushConverter x:Key="StatusBrushConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 标题 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="批量退迁" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="一次退迁多条迁移生成的目录链接：解析目标 → 复制回原路径 → 删除链接与旧目标。可粘贴多行、拖入文件夹或点“选择”添加。" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 添加区 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="粘贴添加（每行一个链接路径）" Style="{StaticResource Label}"/>
                    <TextBox x:Name="PasteBox" Style="{StaticResource TextBoxStyle}" AcceptsReturn="True"
                             TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             ToolTip="每行一个迁移后的链接路径"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="AddButton" Content="添加" Style="{StaticResource PrimaryButton}" Width="120" Click="AddButton_Click"
                                ToolTip="将编辑框中的每行路径作为一条退迁记录加入列表"/>
                        <Button x:Name="BrowseButton" Content="选择" Style="{StaticResource SecondaryButton}" Width="120" Margin="12,0,0,0" Click="BrowseButton_Click"
                                ToolTip="从文件夹对话框选取一个链接路径加入列表"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="支持一次粘贴多行路径，或点击“选择”，或直接从资源管理器拖入文件夹。"/>
                </StackPanel>
            </Border>

            <!-- 列表 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="退迁列表" Style="{StaticResource Label}"/>
                    <DataGrid x:Name="RowGrid" MinHeight="220" AllowDrop="True"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              RowBackground="White" AlternatingRowBackground="{StaticResource HoverBrush}"
                              SelectionMode="Extended"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewDragOver="RowGrid_PreviewDragOver" PreviewDrop="RowGrid_PreviewDrop">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="链接路径" Binding="{Binding LinkPath}" Width="300"/>
                            <DataGridTextColumn Header="目标路径" Binding="{Binding Target}" Width="300" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="状态" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 底部操作与进度 -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="RemoveButton" Content="移除选中" Style="{StaticResource SecondaryButton}" Width="100" Click="RemoveButton_Click"/>
                        <Button x:Name="ClearButton" Content="清空" Style="{StaticResource SecondaryButton}" Width="80" Margin="10,0,0,0" Click="ClearButton_Click"/>
                        <Button x:Name="StartButton" Content="开始批量退迁" Style="{StaticResource PrimaryButton}" Width="150" Margin="10,0,0,0" Click="StartButton_Click"/>
                    </StackPanel>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressCountText" Text="0/0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="ProgressBar" Grid.Column="1" Style="{StaticResource ProgressBarStyle}" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>