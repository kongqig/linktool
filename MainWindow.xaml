<Window x:Class="linktool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinkTool - 文件夹移动工具"
        Width="520"
        Height="260"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontSize="14"
        FontFamily="Microsoft YaHei, SimSun, Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- From 标签行 -->
            <RowDefinition Height="Auto" />
            <!-- From 编辑框 + 选择按钮行 -->
            <RowDefinition Height="Auto" />
            <!-- 间距 -->
            <RowDefinition Height="12" />
            <!-- To 标签行 -->
            <RowDefinition Height="Auto" />
            <!-- To 编辑框 + 选择按钮行 -->
            <RowDefinition Height="Auto" />
            <!-- 间距 -->
            <RowDefinition Height="16" />
            <!-- 底部按钮行 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- From 标签 -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="From（选择要移动的文件夹）："
                   Margin="0,0,0,4" />

        <!-- From 编辑框 -->
        <TextBox Grid.Row="1" Grid.Column="0"
                 x:Name="FromTextBox"
                 Margin="0,0,8,0"
                 IsReadOnly="True"
                 VerticalContentAlignment="Center"
                 Padding="4,0" />

        <!-- From 选择按钮 -->
        <Button Grid.Row="1" Grid.Column="1"
                x:Name="FromBrowseButton"
                Content="选择"
                Width="80"
                Click="FromBrowseButton_Click" />

        <!-- To 标签 -->
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                   Text="To（目标文件夹）："
                   Margin="0,0,0,4" />

        <!-- To 编辑框 -->
        <TextBox Grid.Row="4" Grid.Column="0"
                 x:Name="ToTextBox"
                 Margin="0,0,8,0"
                 IsReadOnly="True"
                 VerticalContentAlignment="Center"
                 Padding="4,0" />

        <!-- To 选择按钮 -->
        <Button Grid.Row="4" Grid.Column="1"
                x:Name="ToBrowseButton"
                Content="选择"
                Width="80"
                Click="ToBrowseButton_Click" />

        <!-- 底部按钮区域 -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <!-- 以管理员身份运行按钮 -->
            <Button x:Name="RunAsAdminButton"
                    Content="以管理员身份运行"
                    Width="160"
                    Margin="0,0,16,0"
                    Click="RunAsAdminButton_Click" />

            <!-- 移动按钮 -->
            <Button x:Name="MoveButton"
                    Content="移动"
                    Width="100"
                    Click="MoveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
