<Window x:Class="linktool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinkTool - 文件夹迁移与链接"
        Width="1020"
        Height="680"
        MinWidth="860"
        MinHeight="560"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        FontSize="14"
        FontFamily="Segoe UI, Microsoft YaHei"
        Background="{StaticResource WindowBgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 侧边栏 ===== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 品牌区 -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <TextBlock Text="LinkTool" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="文件夹迁移与目录链接" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 管理员状态 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16" VerticalAlignment="Bottom">
                    <Border CornerRadius="8" Background="{StaticResource HoverBrush}" Padding="12,10">
                        <StackPanel>
                            <TextBlock x:Name="AdminStatusText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <Button x:Name="AdminRestartButton" Content="以管理员身份运行"
                                    Style="{StaticResource SecondaryButton}" Padding="8,6" Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch" Click="AdminRestartButton_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 导航 -->
                <StackPanel Margin="12,8">
                    <RadioButton x:Name="NavMigration" GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                 Content="迁移" Tag="migration" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavBatchMigration" GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                 Content="批量迁移" Tag="batch-migration" Checked="Nav_Checked"/>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                 Content="链接" Tag="link" Checked="Nav_Checked"/>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                 Content="批量链接" Tag="batch-link" Checked="Nav_Checked"/>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                 Content="退迁" Tag="retreat" Checked="Nav_Checked"/>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                 Content="批量退迁" Tag="batch-retreat" Checked="Nav_Checked"/>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                 Content="帮助" Tag="help" Checked="Nav_Checked"/>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                 Content="关于" Tag="about" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 内容区 ===== -->
        <Grid Grid.Column="1" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 页面容器 -->
            <ContentControl x:Name="PageHost" Grid.Row="0"/>

            <!-- 管理员警告条（仅非管理员时显示） -->
            <Border x:Name="AdminWarningBar" Grid.Row="1" Margin="0,16,0,0"
                    Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="当前未以管理员身份运行，部分复制/删除/链接操作可能因权限不足失败。建议提权运行。"
                               Foreground="{StaticResource WarnBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Content="提权运行" Style="{StaticResource SecondaryButton}"
                            Padding="14,6" Margin="12,0,0,0" Click="AdminRestartButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>