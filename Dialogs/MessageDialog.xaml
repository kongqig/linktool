<Window x:Class="linktool.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei"
        FontSize="14"
        KeyDown="Window_KeyDown">

    <Border Margin="20" Background="White" CornerRadius="14"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="28,24" MaxWidth="460">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBadge" Width="40" Height="40" CornerRadius="20">
                    <TextBlock x:Name="IconGlyph" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="14,0,0,0"
                           FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="13"/>
            <StackPanel HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="OkButton" Content="确定" Style="{StaticResource PrimaryButton}" MinWidth="88"
                        Click="OkButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>