<Window x:Class="linktool.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei"
        FontSize="14"
        KeyDown="Window_KeyDown">

    <Border Margin="20" Background="White" CornerRadius="14"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="28,24" MaxWidth="460">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBox x:Name="MessageText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="13"
                     BorderThickness="0" Background="Transparent" IsTabStop="False"
                     MaxHeight="320" VerticalScrollBarVisibility="Auto"
                     Foreground="{StaticResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="88"
                        Click="CancelButton_Click"/>
                <Button x:Name="ConfirmButton" Content="确定" Style="{StaticResource PrimaryButton}" MinWidth="88" Margin="12,0,0,0"
                        Click="ConfirmButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>