<Window x:Class="linktool.Dialogs.ProcessListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="占用进程"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei"
        FontSize="14"
        KeyDown="Window_KeyDown">

    <Border Margin="20" Background="White" CornerRadius="14"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="28,24">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource WarnBrush}">
                    <TextBlock Text="&#xE778;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="14,0,0,0"
                           FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <TextBox x:Name="MessageText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="13"
                     BorderThickness="0" Background="Transparent" IsTabStop="False"
                     Foreground="{StaticResource TextSecondaryBrush}"/>

            <ListBox x:Name="ProcList" MinHeight="72" MaxHeight="220" Margin="0,12,0,0"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     Background="{StaticResource HoverBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Display}"
                                  VerticalContentAlignment="Center"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="默认全选。强制结束未保存数据的程序可能造成数据丢失；系统级进程需以管理员身份运行本程序才能结束。"
                       Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="全选" Style="{StaticResource SecondaryButton}" MinWidth="72" Click="SelectAll_Click"
                        ToolTip="勾选全部进程"/>
                <Button Content="关闭（放弃操作）" Style="{StaticResource SecondaryButton}" MinWidth="120" Margin="12,0,0,0"
                        Click="CloseButton_Click" ToolTip="不结束任何进程，放弃本次操作"/>
                <Button x:Name="KillButton" Content="强制结束选中进程" Style="{StaticResource DangerPrimaryButton}" MinWidth="150" Margin="12,0,0,0"
                        Click="KillButton_Click" ToolTip="强制结束勾选的进程，关闭弹窗后自动重新检测"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
